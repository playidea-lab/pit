GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=

# 요약은 이 컴퓨터에 로그인된 Claude Code(구독)로 한다 — API 키 불필요
CLAUDE_BIN=claude
CLAUDE_MODEL=opus

# Gmail 앱 비밀번호 사용 (계정 > 보안 > 2단계 인증 > 앱 비밀번호)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=["ceo@example.com"]
# 인사 평가(대외비) 수신자 — 브리핑 수신자와 분리
EVAL_MAIL_TO=["ceo@example.com"]

# GitHub (선택). 계정·조직 목록에 있는 저장소만 본다
GITHUB_TOKEN=
GITHUB_OWNERS=["your-org"]

# 세션 종료 훅이 소급 기록할 때 쓰는 계정
BACKFILL_WHO=

# pithub 작업 보고 검증 (선택)
PITHUB_URL=
PITHUB_SERVICE_KEY=
