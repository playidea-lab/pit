<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>pithub.watcher-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string><string>run</string><string>--frozen</string><string>git-watcher</string><string>--collector</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <!-- 에이전트 텔레메트리 수집기: 로그인 시 시작, 죽으면 다시 띄운다 -->
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__ROOT__/logs/collector.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/logs/collector.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__HOME__/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
